# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (for free model fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Razorpay Payment Integration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Managed Graph Database (Supabase PostgreSQL - Optional, falls back to local graph_data.json)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Lyzr AI SuperFlow Webhook Integration (Optional - replaces final LLM answer generation)
LYZR_WEBHOOK_URL=https://inference.studio.lyzr.ai/api/workflows/execute
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_WEBHOOK_SECRET=your_lyzr_webhook_secret_here
LYZR_WORKFLOW_ID=your_lyzr_workflow_id_here
